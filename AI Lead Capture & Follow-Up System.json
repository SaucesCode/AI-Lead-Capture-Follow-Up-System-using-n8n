    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const email = item.json;\n  return {\n    json: {\n      subject: email.subject,\n      from: email.from.text,\n      body: email.text || email.html\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        560
      ],
      "id": "ba0a294a-7883-4f81-b092-72afc58ea16b",
